<% actions_outside_dropdown.each do |action| %>
  <%= action.render_as_button(record: record, view: self.view_context) %>
<% end %>

<% if actions_inside_dropdown.any? %>
  <div class="relative" data-controller="dropdown">
    <%= render(Uchi::Flowbite::Button.new(style: :secondary, :data => {:action => "dropdown#toggle click@window->dropdown#hide"}, id: button_id)) do %>
      <div class="inline-flex items-center">
        <%= repository.translate.actions_button_label %>

        <svg
          aria-hidden="true"
          class="w-4 h-4 ms-1.5 -me-0.5"
          fill="none"
          height="24"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="m19 9-7 7-7-7"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          />
        </svg>
      </div>
    <% end %>

    <!-- Dropdown menu -->
    <div
      aria-hidden="true"
      aria-orientation="vertical"
      class="
        transition transform origin-top-right absolute z-10 hidden bg-neutral-primary-medium border border-default-medium
        rounded-base shadow-lg w-44 mt-1 right-0
      "
      data-dropdown-target="menu"
      id="<%= dropdown_id %>"
      role="menu"
      tabindex="-1"
    >
      <ul
        aria-labelledby="<%= button_id %>"
        class="p-2 text-sm text-body font-medium"
      >
        <% actions_inside_dropdown.each do |action| %>
          <li role="menuitem">
            <%= action.render_as_dropdown_item(record: record, view: self.view_context) %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
