<div class="my-6">
  <h3 class="text-lg font-semibold text-heading mb-3">
    <%= repository.translate.field_label(field) %>
  </h3>

  <% if associated_records.empty? %>
    <p class="text-body-subtle italic">
      <%= I18n.t("uchi.field.nested_many.no_items", default: "No items") %>
    </p>
  <% else %>
    <div class="space-y-3">
      <% associated_records.each do |assoc_record| %>
        <div class="border border-default-medium rounded-base p-4 bg-neutral-primary-medium">
          <dl class="grid grid-cols-1 gap-3">
            <% nested_field_components.each do |nested_field| %>
              <div>
                <dt class="text-sm font-medium text-heading mb-1">
                  <%= associated_repository.translate.field_label(nested_field) %>
                </dt>
                <dd class="text-sm text-body">
                  <%= render(nested_field.show_component(
                    record: assoc_record,
                    repository: associated_repository
                  )) %>
                </dd>
              </div>
            <% end %>
          </dl>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
