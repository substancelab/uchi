<% if field.nested_fields.any? %>
  <div
    data-controller="nested-fields"
    data-nested-fields-association-name-value="<%= field.param_key %>"
  >
    <%= render(Uchi::Flowbite::Input::Label.new(attribute: field.name, form: form)) { label } %>

    <div class="space-y-3 mt-2" data-nested-fields-target="container">
      <%# Render existing associated records %>
      <% associated_records.each_with_index do |assoc_record, index| %>
        <div
          class="border border-default-medium rounded-base p-4 bg-neutral-primary-medium relative"
          data-nested-fields-target="item"
          data-new-record="<%= assoc_record.new_record? %>"
        >
          <%= form.fields_for(field.name, assoc_record, child_index: index) do |nested_form| %>
            <%# Hidden field for ID (existing records only) %>
            <% unless assoc_record.new_record? %>
              <%= nested_form.hidden_field :id %>
            <% end %>

            <%# Hidden field for _destroy %>
            <%= nested_form.hidden_field :_destroy, value: "0", data: {nested_fields_target: "destroyField"} %>

            <div class="grid grid-cols-1 gap-4 mb-3">
              <%# Render each configured nested field %>
              <% field.nested_fields.each do |nested_field| %>
                <div>
                  <%= render(nested_field.edit_component(
                    form: nested_form,
                    repository: associated_repository,
                    label: associated_repository.translate.field_label(nested_field),
                    hint: nil
                  )) %>
                </div>
              <% end %>
            </div>

            <%# Remove button %>
            <div class="absolute top-2 right-2">
              <button
                aria-label="<%= I18n.t("uchi.field.has_many.nested.remove_item", default: "Remove") %>"
                class="text-danger hover:text-danger-emphasis p-1 rounded hover:bg-danger/10"
                data-action="nested-fields#removeItem"
                title="<%= I18n.t("uchi.field.has_many.nested.remove_item", default: "Remove") %>"
                type="button"
              >
                <svg
                  class="w-5 h-5"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"
                  />
                </svg>
              </button>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Template for new records (hidden, cloned by Stimulus) %>
      <template data-nested-fields-target="template">
        <div
          class="border border-default-medium rounded-base p-4 bg-neutral-primary-medium relative"
          data-nested-fields-target="item"
          data-new-record="true"
        >
          <%= form.fields_for(field.name, reflection.klass.new, child_index: "NEW_RECORD") do |nested_form| %>
            <%# Hidden field for _destroy (new records don't have ID) %>
            <%= nested_form.hidden_field :_destroy, value: "0", data: {nested_fields_target: "destroyField"} %>

            <div class="grid grid-cols-1 gap-4 mb-3">
              <%# Render each configured nested field %>
              <% field.nested_fields.each do |nested_field| %>
                <div>
                  <%= render(nested_field.edit_component(
                    form: nested_form,
                    repository: associated_repository,
                    label: associated_repository.translate.field_label(nested_field),
                    hint: nil
                  )) %>
                </div>
              <% end %>
            </div>

            <%# Remove button %>
            <div class="absolute top-2 right-2">
              <button
                aria-label="<%= I18n.t("uchi.field.has_many.nested.remove_item", default: "Remove") %>"
                class="text-danger hover:text-danger-emphasis p-1 rounded hover:bg-danger/10"
                data-action="nested-fields#removeItem"
                title="<%= I18n.t("uchi.field.has_many.nested.remove_item", default: "Remove") %>"
                type="button"
              >
                <svg
                  class="w-5 h-5"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"
                  />
                </svg>
              </button>
            </div>
          <% end %>
        </div>
      </template>
    </div>

    <div class="mt-3">
      <%= render(Uchi::Flowbite::Button.new(
        type: "button",
        style: :secondary,
        size: :sm,
        data: {action: "nested-fields#addItem"}
      )) do %>
        <svg
          class="w-4 h-4 inline-block mr-1 -ml-1"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 12h14m-7 7V5"
          />
        </svg>
        <%= I18n.t("uchi.field.has_many.nested.add_item", default: "Add #{field.name.to_s.singularize.humanize}") %>
      <% end %>
    </div>

    <% if hint.present? %>
      <%= render(Uchi::Flowbite::Input::Hint.new(attribute: field.name, form: form)) { hint } %>
    <% end %>
  </div>
<% else %>
<div
  class="relative"
  data-action="keydown.esc->has-many#closeDropdown"
  data-controller="has-many"
  data-has-many-backend-url-value="<%= helpers.uchi.has_many_associated_records_path(field: field.name, model: repository.model, record_id: record&.id) %>"
  data-has-many-field-name-value="<%= field_name_for_input %>"
>
  <%= render(Uchi::Flowbite::Input::Label.new(attribute: field.name, form: form, options: {for: dom_id_for_toggle})) { label } %>

  <%# Hidden fields to store selected IDs as an array %>
  <div data-has-many-target="idsContainer">
    <% associated_records.each do |assoc_record| %>
      <input
        type="hidden"
        name="<%= field_name_for_input %>"
        value="<%= assoc_record.id %>"
        data-has-many-target="idField"
        data-title="<%= record_title(assoc_record) %>"
      >
    <% end %>
  </div>

  <button
    class="<%= Uchi::Flowbite::Input.classes.join(" ") %> text-left"
    data-action="has-many#toggle"
    id="<%= dom_id_for_toggle %>"
    type="button"
  >
    <div class="inline-flex items-center justify-between w-full">
      <div class="min-h-[1em] truncate" data-has-many-target="label">
        <% if associated_records.any? %>
          <%= selected_titles %>
        <% else %>
          <span class="text-body-subtle">Select items...</span>
        <% end %>
      </div>
      <svg
        class="w-4 h-4 ms-1.5 -me-0.5 flex-shrink-0"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        fill="none"
        viewBox="0 0 24 24"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m19 9-7 7-7-7"
        />
      </svg>
    </div>
  </button>

  <div class="absolute z-10 bg-neutral-primary-medium border border-default-medium rounded-base shadow-lg w-full mt-1" data-has-many-target="dropdown">
    <div class="p-2 border-b border-default-medium">
      <%# Search input. This is the visible part that users type into %>
      <label for="<%= dom_id_for_filter_query_input %>" class="sr-only">Search</label>
      <%=
        text_field_tag(
          "filter_query",
          nil,
          class: "bg-neutral-secondary-strong border border-default-strong text-heading text-sm rounded focus:ring-brand focus:border-brand block w-full px-2.5 py-2 shadow-xs placeholder:text-body",
          data: {
            'has-many-target': 'input',
            action: 'has-many#handleChange focus->has-many#handleFocus',
            autocomplete: 'off'
          },
          id: dom_id_for_filter_query_input,
        )
      %>
    </div>
    <div class="max-h-96 overflow-y-auto" data-has-many-target="list">
      <!-- Options will be dynamically inserted here -->
      <div class="grid place-items-center p-8">
        <%= render(Uchi::Ui::Spinner.new(message: associated_repository.translate.loading_message)) %>
      </div>
    </div>
  </div>

  <% if hint.present? %>
    <%= render(Uchi::Flowbite::Input::Hint.new(attribute: field.name, form: form)) { hint } %>
  <% end %>
</div>
<% end %>
