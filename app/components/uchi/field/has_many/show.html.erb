<% if field.nested_fields.any? %>
  <div class="my-6">
    <div class="mb-3">
      <%= render(Uchi::Ui::SectionHeader.new(title: repository.translate.field_label(field))) %>
    </div>

    <% if associated_records.empty? %>
      <p class="text-body-subtle italic">
        <%= I18n.t("uchi.field.has_many.nested.no_items", default: "No items") %>
      </p>
    <% else %>
      <div class="space-y-3">
        <% associated_records.each do |assoc_record| %>
          <div
            class="
              border border-default-medium rounded-base p-4
              bg-neutral-primary-medium
            "
          >
            <dl class="grid grid-cols-1 gap-3">
              <% field.nested_fields.each do |nested_field| %>
                <div>
                  <dt class="text-sm font-medium text-heading mb-1">
                    <%= associated_repository.translate.field_label(nested_field) %>
                  </dt>

                  <dd class="text-sm text-body">
                    <%= render(nested_field.show_component(
                      record: assoc_record,
                      repository: associated_repository
                    )) %>
                  </dd>
                </div>
              <% end %>
            </dl>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="my-10">
    <div class="px-4 my-6 md:px-0">
      <%= render(Uchi::Ui::SectionHeader.new(title: repository.translate.field_label(field))) do |section_header| %>
        <% section_header.with_action do %>
          <%= link_to(
            associated_repository.translate.link_to_add,
            associated_repository.routes.path_for(:new, scope: attach_scope),
            class: Uchi::Flowbite::Button::Outline.classes(style: :tertiary)
          ) %>
        <% end %>
      <% end %>
    </div>

    <%= render(Uchi::Ui::Index::TurboFrame.new(
      repository: associated_repository,
      scope: {
        field: field.name,
        id: record.id,
        inverse_of: inverse_association&.name,
        model: record.model_name,
      },
      src: associated_repository.routes.path_for(
        :index,
        scope: {
          field: field.name,
          id: record.id,
          inverse_of: inverse_association&.name,
          model: record.model_name,
        },
      )
    )) do %>
      <%= render(Uchi::Ui::Frame.new) do %>
        <div class="grid place-items-center p-8">
          <%= render(Uchi::Ui::Spinner.new(message: repository.translate.loading_message)) %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
