<div class="my-10">
  <div class="flex items-center justify-between px-4 my-6 md:px-0">
    <h2 class="text-2xl font-semibold tracking-tight text-heading">
      <%= repository.translate.field_label(field) %>
    </h2>

    <%= link_to(
      associated_repository.translate.link_to_add,
      associated_repository.routes.path_for(:new, scope: attach_scope),
      class: Uchi::Flowbite::Button::Outline.classes(style: :tertiary)
    ) %>
  </div>

  <%= render(Uchi::Ui::Index::TurboFrame.new(
    repository: associated_repository,
    scope: {
      field: field.name,
      id: record.id,
      inverse_of: inverse_association&.name,
      model: record.model_name,
    },
    src: associated_repository.routes.path_for(
      :index,
      scope: {
        field: field.name,
        id: record.id,
        inverse_of: inverse_association&.name,
        model: record.model_name,
      },
    )
  )) do %>
    <%= render(Uchi::Ui::Frame.new) do %>
      <div class="grid place-items-center p-8">
        <%= render(Uchi::Ui::Spinner.new(message: repository.translate.loading_message)) %>
      </div>
    <% end %>
  <% end %>
</div>
